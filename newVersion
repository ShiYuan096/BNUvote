                    vm.username = "{username}";
                    vm.password = "{password}";
                    vm.login();
                    return true;
                }}
                return false;
                """
                self.driver.execute_script(script)
                time.sleep(5)
                
                # 备用 Selenium 登录
                if "登录" in self.driver.title:
                    try:
                        self.driver.find_element(By.CSS_SELECTOR, "input[type='text']").send_keys(username)
                        self.driver.find_element(By.CSS_SELECTOR, "input[type='password']").send_keys(password)
                        self.driver.find_element(By.CSS_SELECTOR, "div.btn").click()
                        time.sleep(5)
                    except:
                        pass

            return True 
        except Exception as e:
            print(f"❌ 登录过程异常: {e}")
            return False
    
    def extract_vote_data_after_login(self):
        try:
            # 尝试点击查看统计
            try:
                # 这里的XPath可能需要根据实际页面微调
                btns = self.driver.find_elements(By.XPATH, "//button[contains(text(), '统计') or contains(text(), '结果')]")
                if btns:
                    self.driver.execute_script("arguments[0].click();", btns[0])
                    time.sleep(3)
            except:
                pass
            
            extractor = BNUVoteDataExtractor(self.driver)
            candidates_data = extractor.extract_candidate_data()
            analysis = extractor.analyze_vote_results(candidates_data)
            
            if not candidates_data:
                return None
                
            return {'candidates': candidates_data, 'analysis': analysis}
            
        except Exception as e:
            print(f"❌ 数据提取异常: {e}")
            return None

    def run(self, username, password):
        try:
            if not self.solve_login(username, password):
                return None
            result = self.extract_vote_data_after_login()
            return result
        finally:
            if self.driver:
                self.driver.quit()

